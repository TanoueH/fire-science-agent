# 🔑 OpenAI API Key (gere em https://platform.openai.com/api-keys)
OPENAI_API_KEY=coloque_sua_chave_aqui

# 🤖 Modelo LLM a ser usado (recomendado gpt-4o ou gpt-4.1)
MODEL=gpt-4o

# 📊 Arquivo CSV de sensores
INPUT_CSV=./sample_sensors.csv

# 📑 Caminho do relatório final em Markdown
REPORT_FILE=./output/report.md
